# Copy to .env.local for development, and add the same names in Vercel → Project → Settings → Environment Variables.

# The one owner account. Whoever signs up with this email gets the admin area. Everyone else is a member.
OWNER_EMAIL=you@example.com

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret: server only, never share

# Anthropic Console → API keys (secret: server only)
ANTHROPIC_API_KEY=

# The public address of the site (used in sign-up and password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
CONTACT_EMAIL=                         # public contact address shown on the privacy, terms and footer (optional)
ENABLE_GOOGLE_SIGNIN=0                # 1 after enabling the Google provider in Supabase → Authentication
# Local mode only (no Supabase): signs session cookies. Any long random string.
SESSION_SECRET=
# AI_MOCK=1                           # scripted AI answers for testing, no API calls
